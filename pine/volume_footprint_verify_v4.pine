//@version=6
indicator("Volume Footprint [Verify Export v4]", overlay=false)

// ~~ Constants {
const string GRP_CORE = " [ SYSTEM ] CORE SCAN (VERIFY)"
const string TITLE_PREM = "Premium Plan (Allow Seconds TF)"
const string TITLE_LTF = "Lower Timeframe (LTF)"
const string TITLE_ROW = "Row Size Mode"
const string TITLE_TICKS = "Ticks per Row"
//~~~~~}

// ~~ Inputs {
bool is_premium = input.bool(false, TITLE_PREM, group=GRP_CORE)
string ltf_res_input = input.timeframe("1S", TITLE_LTF, group=GRP_CORE)
string row_size_mode = input.string("Auto (20 Tiers)", TITLE_ROW, options=["Manual", "Auto (20 Tiers)"], group=GRP_CORE)
int ticks_per_row = input.int(1, TITLE_TICKS, minval=1, group=GRP_CORE)
//~~~~~}

// ~~ Calculation {
bool is_sec_tf = str.contains(ltf_res_input, "S")
string actual_ltf = (not is_premium and is_sec_tf) ? "1" : ltf_res_input

[ltf_o, ltf_h, ltf_l, ltf_c, ltf_v] = request.security_lower_tf(syminfo.tickerid, actual_ltf, [open, high, low, close, volume])
float global_atr = ta.atr(14)

// LTFが無いバーはCSVで出力させない（naにする）ための初期化
float total_v_bar = na
float bought_t = na
float sold_t = na
float delta = na
float poc_price = na
float step_out = na
float buy_ratio_out = na
float sell_ratio_out = na
float rows_norm_out = na
int ltf_size_out = na
int total_r_out = na

if array.size(ltf_v) > 0
    total_v_bar := 0.0
    bought_t := 0.0
    sold_t := 0.0

    float current_atr = global_atr
    if na(current_atr) or current_atr == 0
        current_atr := close * 0.005

    int auto_ticks = math.max(1, math.round((current_atr / 20) / syminfo.mintick))
    int active_ticks = row_size_mode == "Auto (20 Tiers)" ? auto_ticks : ticks_per_row
    step_out := syminfo.mintick * active_ticks

    float bar_l = low
    float bar_h = high
    int total_r = math.ceil((bar_h - bar_l) / step_out) + 1

    float[] ask_v_arr = array.new_float(total_r, 0.0)
    float[] bid_v_arr = array.new_float(total_r, 0.0)
    float[] tot_v_arr = array.new_float(total_r, 0.0)

    ltf_size_out := array.size(ltf_v)
    total_r_out := total_r

    for i = 0 to ltf_size_out - 1
        float c_o = array.get(ltf_o, i)
        float c_h = array.get(ltf_h, i)
        float c_l = array.get(ltf_l, i)
        float c_c = array.get(ltf_c, i)
        float c_v = array.get(ltf_v, i)

        int ticks_1s = math.round((c_h - c_l) / syminfo.mintick) + 1
        float v_tick = c_v / ticks_1s

        int s_idx = math.round((c_l - bar_l) / step_out)
        int e_idx = math.round((c_h - bar_l) / step_out)

        for t_idx = s_idx to e_idx
            if t_idx >= 0 and t_idx < total_r
                if c_c > c_o
                    array.set(ask_v_arr, t_idx, array.get(ask_v_arr, t_idx) + v_tick)
                else if c_c < c_o
                    array.set(bid_v_arr, t_idx, array.get(bid_v_arr, t_idx) + v_tick)
                else
                    array.set(ask_v_arr, t_idx, array.get(ask_v_arr, t_idx) + (v_tick / 2))
                    array.set(bid_v_arr, t_idx, array.get(bid_v_arr, t_idx) + (v_tick / 2))

    float max_r_v = 0.0
    int poc_idx = -1

    for i = 0 to total_r - 1
        float a_v = array.get(ask_v_arr, i)
        float b_v = array.get(bid_v_arr, i)
        float tot = a_v + b_v
        array.set(tot_v_arr, i, tot)

        max_r_v := math.max(max_r_v, tot)
        bought_t += a_v
        sold_t += b_v
        total_v_bar += tot

    delta := bought_t - sold_t

    if total_v_bar > 0
        buy_ratio_out := bought_t / total_v_bar
        sell_ratio_out := sold_t / total_v_bar

    if high != low
        rows_norm_out := total_r * step_out / (high - low)

    if max_r_v > 0
        for i = 0 to total_r - 1
            if array.get(tot_v_arr, i) == max_r_v
                poc_idx := i
                break

    if poc_idx >= 0
        poc_price := bar_l + (poc_idx * step_out)
//~~~~~}

// ~~ Output {
plot(total_v_bar, "total_vol", color=color.blue)
plot(bought_t,    "buy_vol",   color=color.green)
plot(sold_t,      "sell_vol",  color=color.red)
plot(delta,       "delta",     color=color.purple)
plot(poc_price,   "poc_price", color=color.orange)
plot(global_atr,  "atr14",     color=color.gray)
plot(step_out,    "step",      color=color.black)
plot(volume, "raw_volume", color=color.teal)
plot(ltf_size_out, "ltf_count", color=color.navy)
plot(total_r_out, "rows", color=color.maroon)
plot(buy_ratio_out, "buy_ratio", color=color.olive)
plot(sell_ratio_out, "sell_ratio", color=color.silver)
plot(rows_norm_out, "rows_norm", color=color.green)
//~~~~~}